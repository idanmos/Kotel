    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Standortzugriff, damit der Kompass auch im Hintergrund zur Kotel zeigen kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow location access so the compass can keep pointing toward the Kotel even in the background"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la ubicación para que la brújula pueda seguir señalando hacia el Kotel en segundo plano"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à la localisation pour que la boussole puisse continuer à pointer vers le Kotel en arrière-plan"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה למיקום כדי שהמצפן יוכל להמשיך להצביע לכיוון הכותל גם ברקע"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à localização para que a bússola possa continuar apontando para o Kotel em segundo plano"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к местоположению, чтобы компас мог продолжать указывать на Котель в фоновом режиме"
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דערלויב צוטריט צום אָרט כדי דער קאָמפּאַס קען ווייַטער ווייַזן צו דער כּותל אין הינטערגרונט"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow location access so the widget can point you toward the Kotel in Jerusalem"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Standortzugriff, damit wir dich zur Klagemauer in Jerusalem führen können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location access so we can point you toward the Kotel in Jerusalem"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la ubicación para señalarte hacia el Kotel en Jerusalén"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à la localisation pour vous orienter vers le Kotel à Jérusalem"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה למיקום כדי שנוכל להצביע לכיוון הכותל בירושלים"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à localização para apontarmos para o Kotel em Jerusalém"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к местоположению, чтобы мы могли указать на Котель в Иерусалиме"
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דערלויב צוטריט צום אָרט כדי מיר קענען ווייַזן צו די כּותל אין ירושלים"
          }
        }
      }
