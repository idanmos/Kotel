    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Standortzugriff, damit wir dich zur Klagemauer in Jerusalem führen können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location access so we can point you toward the Kotel in Jerusalem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la ubicación para señalarte hacia el Kotel en Jerusalén"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à la localisation pour vous orienter vers le Kotel à Jérusalem"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה למיקום כדי שנוכל להצביע לכיוון הכותל בירושלים"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à localização para apontarmos para o Kotel em Jerusalém"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к местоположению, чтобы мы могли указать на Котель в Иерусалиме"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דערלויב צוטריט צום אָרט כדי מיר קענען ווייַזן צו די כּותל אין ירושלים"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الموقع حتى نتمكن من توجيهك نحو حائط البراق في القدس"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问位置信息，以便我们为您指引耶路撒冷西墙的方向"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान की अनुमति दें ताकि हम आपको येरूशलम में कोटेल की दिशा दिखा सकें"
          }
        }
      }
    }
  },
  "version": "1.0"
}
