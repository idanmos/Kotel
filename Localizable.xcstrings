    "Allow location access so we can\npoint you toward the Kotel in Jerusalem": {
      "comment": "Permission screen description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Standortzugriff, damit wir dich\nzur Klagemauer in Jerusalem führen können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location access so we can\npoint you toward the Kotel in Jerusalem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la ubicación para\nseñalarte hacia el Kotel en Jerusalén"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à la localisation pour\nvous orienter vers le Kotel à Jérusalem"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה למיקום כדי\nשנוכל להצביע לכיוון הכותל בירושלים"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à localização para\napontarmos para o Kotel em Jerusalém"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к местоположению, чтобы\nмы могли указать на Котель в Иерусалиме"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דערלויב צוטריט צום אָרט כדי\nמיר קענען ווייַזן צו די כּותל אין ירושלים"
          }
        }
      }
    },
