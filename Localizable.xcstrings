    "Open Settings and enable location\naccess to use the Western Wall compass" : {
      "comment" : "Denied permission screen description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الإعدادات وفعّل الوصول إلى\nالموقع لاستخدام بوصلة حائط البراق"
          }
        },
        "de" : {
          "stringUnit" : {
